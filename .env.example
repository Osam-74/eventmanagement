# ------------------------------------------------------------------
# Client-safe Firebase web config (NOT secret, safe for the browser)
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# Server-only secrets — NEVER expose to the client or commit to Git
# ------------------------------------------------------------------

# Firebase service account (from Firebase console > Project settings >
# Service accounts > Generate new private key). Store the values, not the JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Multi-line private key. In Vercel paste it with real newlines; the app
# also tolerates "\n" escaped newlines.
FIREBASE_PRIVATE_KEY=
# Storage bucket name (same as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
FIREBASE_STORAGE_BUCKET=

# Random 32+ byte secret used to HMAC QR credentials (hex or base64).
# Generate with:  openssl rand -hex 32
QR_TOKEN_HMAC_KEY=

# Random secret pepper for usher PIN verification. Generate separately.
USHER_PIN_PEPPER=

# Random secret for signing usher scanner session cookies. Generate separately.
USHER_SESSION_SECRET=
